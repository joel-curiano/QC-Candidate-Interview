digraph QCCandidateInterview {
    graph [
        label="QC Competency Technical Assessment Portal",
        labelloc=t,
        fontsize=20,
        fontname="Arial",
        rankdir=TB,
        nodesep=0.45,
        ranksep=0.7,
        bgcolor="white"
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Arial",
        fontsize=11,
        fillcolor="#F8FAFC",
        color="#475569",
        margin="0.14,0.08"
    ];

    edge [color="#64748B", fontname="Arial", fontsize=10, arrowsize=0.75];

    users [label="Users", fillcolor="#E0F2FE"];
    login [label="Login and confidentiality\nacceptance", fillcolor="#DBEAFE"];

    candidate [label="Candidate", fillcolor="#DCFCE7"];
    staff [label="Reviewer or Admin", fillcolor="#FEF3C7"];

    choose [label="Choose scheduled\ndiscipline"];
    assessment [label="Randomized MCQ, essay,\noral and practical assessment"];
    draft [label="Persist draft and\ntimer state"];
    submit [label="Submit assessment"];
    results [label="View results and\nfeedback"];

    create [label="Create candidate and\nreviewer accounts"];
    confirm_delete_candidate [label="Confirm permanent\ncandidate account deletion"];
    delete_candidate [label="Delete candidate account\nand assessment data"];
    schedule [label="Schedule assessment date, discipline\nand discipline-specific candidate role"];
    question_bank [label="Manage disciplines\nand questions"];
    review [label="Review assessments\n(project and discipline filters)"];
    assessment_project [label="Reassign one assessment\nto a project"];
    analytics [label="Assessment analytics\n(total and filterable per-project results)", fillcolor="#F3E8FF"];
    analytics_export [label="Export analytics PDF\n(per-candidate grading summaries)"];
    settings [label="Assessment settings"];
    admin [label="Projects, accounts, maintenance\nand confidentiality register"];
    grade [label="Score essay, oral and\npractical responses"];
    export [label="Export CTA Record\nLog Excel"];
    result_email [label="Email candidate results"];

    app [label="Streamlit application\napp.py and pages/", fillcolor="#EDE9FE"];
    database [label="Supabase PostgreSQL\nprivate qc_portal schema", shape=cylinder, fillcolor="#FCE7F3"];
    analysis [label="Assessment analysis", fillcolor="#F3E8FF"];
    smtp [label="SMTP email service", shape=component, fillcolor="#FFEDD5"];

    users -> login;
    login -> candidate;
    login -> staff;

    candidate -> choose;
    choose -> assessment;
    assessment -> draft;
    assessment -> submit;
    submit -> results;

    staff -> create;
    staff -> schedule;
    staff -> question_bank;
    staff -> review;
    staff -> analytics;
    analytics -> analytics_export;
    staff -> settings;
    analytics -> settings [label="next sidebar item", style=dashed, constraint=false];
    staff -> admin;
    admin -> confirm_delete_candidate;
    confirm_delete_candidate -> delete_candidate [label="final confirmation"];
    review -> grade;
    review -> assessment_project;
    review -> export;
    review -> result_email;

    app -> database;
    assessment -> database [label="drafts and submissions"];
    submit -> database;
    grade -> database;
    assessment_project -> database [label="per-assessment project attribution"];
    create -> database;
    delete_candidate -> database [label="account, submissions and draft"];
    schedule -> database;
    question_bank -> database;
    schedule -> assessment [label="assigned candidate role"];
    settings -> database;
    admin -> database;

    app -> analysis;
    analysis -> database [label="stored reports"];
    app -> analytics;
    analytics -> database [label="visible submissions and grades"];

    create -> smtp [label="staff credentials"];
    schedule -> smtp [label="candidate invitation"];
    result_email -> smtp [label="result delivery"];
}
